{
  "items": [
    {
      "name": "Kindle Weather",
      "priority": 1,
      "items": [
        {
          "name": "Start Weather Loop",
          "priority": 1,
          "action": "/bin/sh",
          "params": "-c '(sleep 1; exec /mnt/us/weather/weather_loop.sh) </dev/null >/dev/null 2>&1 &'",
          "exitmenu": true
        },
        {
          "name": "Update Weather Now (Single Shot)",
          "priority": 2,
          "action": "/bin/sh",
          "params": "/mnt/us/weather/show_weather.sh",
          "exitmenu": true
        },
        {
          "name": "Stop Weather Loop & Restore Kindle UI",
          "priority": 3,
          "action": "/bin/sh",
          "params": "/mnt/us/weather/weather_loop.sh --stop",
          "exitmenu": true
        }
      ]
    }
  ]
}
